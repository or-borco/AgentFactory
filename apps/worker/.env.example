DATABASE_URL=postgres://agentfactory:agentfactory@localhost:5432/agentfactory
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=

# Same GitHub App as apps/web (apps/web/src/server/github-app.ts) — the worker mints its own
# clone tokens directly rather than calling back into apps/web.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Built locally: docker build -t agentfactory-sandbox:local apps/worker/sandbox-image
SANDBOX_IMAGE=agentfactory-sandbox:local

# If your Docker daemon isn't at the default /var/run/docker.sock (e.g. Colima, Rancher Desktop),
# dockerode needs the standard DOCKER_HOST env var pointed at it — check `docker context ls`.
# DOCKER_HOST=unix:///path/to/docker.sock

# How many runs the worker processes at once. Safe to raise: each run gets its own Docker
# sandbox, so runs against different sessions don't share state. Defaults to 5.
# RUN_WORKER_CONCURRENCY=5

# Storage for uploaded team documents. `fs` writes files under BLOB_DIR; `s3` puts them in
# S3_BUCKET using the ambient AWS credential chain. A relative BLOB_DIR resolves against the repo
# root, never the process cwd — apps/web and apps/worker start from different directories, so this
# value must be IDENTICAL in both .env.local files or the worker reads nothing the web app wrote.
BLOB_STORE=fs
BLOB_DIR=.blobs
