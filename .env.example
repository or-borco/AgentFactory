# Shared local-dev config for both apps/web and apps/worker. One real file lives at the repo
# root; apps/web/.env.local and apps/worker/.env.local are symlinks to it (see `pnpm setup:env` /
# scripts/setup-env.sh) so both processes find a config file exactly where they already look for
# one, with nothing to duplicate or keep in sync by hand.

DATABASE_URL=postgres://agentfactory:agentfactory@localhost:5432/agentfactory
REDIS_URL=redis://localhost:6379

# GitHub App used by the Connections feature (apps/web/src/server/github-app.ts). Register one via
# /api/admin/github-app/register (manifest flow — no manual GitHub dashboard form-filling) and
# copy the values it returns here. GITHUB_APP_SLUG is only used by apps/web.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# Only needed to run the worker (real agent execution) — not required to click around the web UI.
ANTHROPIC_API_KEY=

# Encrypts stored connection credentials (Jira API tokens, etc.) before they're written to the
# database. `pnpm setup:env` generates this for you automatically — it's not something you obtain
# from anywhere, just a random key. If you ever need to regenerate one by hand:
#   openssl rand -base64 32
# Rotating it orphans every stored credential: existing connection_secrets rows become
# undecryptable, and affected users need to reconnect (re-enter their Jira credentials, etc.)
# before those connections work again.
CONNECTION_SECRET_KEY=

# The publicly reachable base URL for this environment (no trailing slash), used to register the
# Telegram bot's webhook (Connections > Telegram). Not needed for GitHub, since the GitHub App's
# callback URL is configured on GitHub's side, not derived here.
PUBLIC_APP_URL=

# Storage for uploaded team/task documents. `fs` writes files under BLOB_DIR; `s3` puts them in
# S3_BUCKET using the ambient AWS credential chain. A relative BLOB_DIR resolves against the repo
# root, not the process's cwd — apps/web and apps/worker start from different directories, which is
# exactly the kind of mismatch this single shared file exists to prevent.
BLOB_STORE=fs
BLOB_DIR=.blobs

# --- apps/worker only, below ---

# Built locally: docker build -t agentfactory-sandbox:local apps/worker/sandbox-image
SANDBOX_IMAGE=agentfactory-sandbox:local

# If your Docker daemon isn't at the default /var/run/docker.sock (e.g. Colima, Rancher Desktop),
# dockerode needs the standard DOCKER_HOST env var pointed at it — check `docker context ls`.
# DOCKER_HOST=unix:///path/to/docker.sock

# Host-side model proxy. ANTHROPIC_API_KEY never enters a sandbox: each agent turn gets a short-lived
# per-run token and reaches the model through this proxy, which swaps the token for the real key.
# Sandboxes reach it at http://MODEL_PROXY_SANDBOX_HOST:MODEL_PROXY_PORT. Defaults shown.
# MODEL_PROXY_PORT=8787
# MODEL_PROXY_BIND=0.0.0.0
# MODEL_PROXY_SANDBOX_HOST=host.docker.internal

# How many runs the worker processes at once. Safe to raise: each run gets its own Docker sandbox,
# so runs against different sessions don't share state. Defaults to 5.
# RUN_WORKER_CONCURRENCY=5
