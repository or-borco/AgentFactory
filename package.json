{
  "name": "agentfactory",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "setup:env": "bash scripts/setup-env.sh",
    "dev": "pnpm --filter @agentfactory/web dev",
    "dev:worker": "pnpm --filter @agentfactory/worker dev",
    "dev:all": "bash scripts/dev-all.sh",
    "stop:all": "bash scripts/stop-all.sh",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:db && pnpm test:queue && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:db": "vitest run --project db-integration",
    "test:queue": "vitest run --project queue-integration",
    "test:e2e": "pnpm --filter @agentfactory/web test:e2e",
    "test:e2e:headed": "bash scripts/test-e2e-headed.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
